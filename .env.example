# Copy these into Render > your Web Service > Environment. Never commit real keys.

# Database (Render Postgres or Supabase Postgres connection string)
DATABASE_URL=
SESSION_SECRET=
NODE_ENV=production

# AI router order (first working provider answers)
AI_PROVIDER_ORDER=bedrock,vertex,anthropic,openai,vertex-openai

# AI (Claude on AWS Bedrock) - create an IAM user with only bedrock:InvokeModel permission
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional model overrides
BEDROCK_MODEL_HEAVY=anthropic.claude-opus-5-5
BEDROCK_MODEL_STANDARD=anthropic.claude-sonnet-5-5
BEDROCK_MODEL_FAST=anthropic.claude-haiku-5-5
# Claude extras on Bedrock
BEDROCK_PROMPT_CACHE=true
BEDROCK_THINKING_BUDGET=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Stripe - use test keys (sk_test_ / pk_test_) until launch
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Healthcare integrations
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_ACCESS_TOKEN=
EPIC_FHIR_BASE_URL=
EPIC_CLIENT_ID=
ORACLE_FHIR_BASE_URL=
ORACLE_CLIENT_ID=
ATHENA_FHIR_BASE_URL=
ATHENA_CLIENT_ID=
SURESCRIPTS_PARTNER_ID=
SURESCRIPTS_API_KEY=
EVV_AGGREGATOR_URL=
EVV_API_KEY=
CLEARINGHOUSE_API_URL=
CLEARINGHOUSE_API_KEY=

# Business integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ESIGN_PROVIDER=
ESIGN_API_KEY=

# Claude direct, ChatGPT, Google Vertex (backup AI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
# Use global (or us / eu) for current Claude models; specific regions like us-east5 only serve older models.
GOOGLE_CLOUD_REGION=global
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Document archive (AWS S3 preferred, Supabase Storage second)
S3_BUCKET=
S3_KMS_KEY_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Daily scan Slack summary
SLACK_SCAN_CHANNEL=

# More connectors
MONDAY_API_TOKEN=
YOUTUBE_API_KEY=
CAPCUT_WORKSPACE_URL=
REPLIT_PROJECT_URL=

# 4000 Connect payments: 64 hex characters (openssl rand -hex 32). Required for live payment connections.
# Changing it makes saved payment connections unreadable; clients would need to reconnect.
F4_SECRETS_KEY=

# OpenAI open models (gpt-oss) on Google Vertex AI: enable gpt-oss in Model Garden, then set true.
VERTEX_OPENAI_ENABLED=false
